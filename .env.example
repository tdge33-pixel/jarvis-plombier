# --- Mode de données -------------------------------------------------------
# "demo"     : base locale en mémoire (fichier .data/demo-db.json), aucun service requis
# "supabase" : PostgreSQL + Auth Supabase (RLS multi-entreprise)
# Laisser vide = "supabase" si NEXT_PUBLIC_SUPABASE_URL est renseigné, sinon "demo".
DATA_BACKEND=

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Session du mode démo (chaîne aléatoire longue) ---------------------------
SESSION_SECRET=

# --- IA ---------------------------------------------------------------------
# "anthropic" | "openai" | "local" (moteur hors-ligne à règles, pour la démo)
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Intégrations -------------------------------------------------------------
COMPOSIO_API_KEY=
